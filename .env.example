APP_NAME=Dashboard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Relocation in Paris"
# Envoi des e-mails en production : MAIL_MAILER=resend et la clé ci-dessous (domaine de MAIL_FROM_ADDRESS vérifié dans Resend).
RESEND_API_KEY=
# Domaines vérifiés chez Resend : un conseiller dont l’e-mail est sur l’un d’eux envoie en son nom.
COMPANY_SENDER_DOMAINS=relocation-in-paris.fr,estate-in-paris.fr

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

COMPANY_NAME="Relocation In Paris"
COMPANY_ADDRESS="Rue des Alpes 5\n1201 Genève\nSuisse"
COMPANY_EMAIL=contact@relocation-in-paris.com
# Alerte « nouveau lead sans contact » : délai en minutes et destinataire (par défaut COMPANY_EMAIL).
LEAD_FIRST_CONTACT_MINUTES=30
LEAD_FIRST_CONTACT_ALERT_EMAIL=
COMPANY_PHONE="+33 1 84 80 43 44"
COMPANY_VAT_NUMBER="CHE-000.000.000 TVA"
COMPANY_IBAN="CH00 0000 0000 0000 0000 0"
COMPANY_BANK="Banque Exemple SA"
# Plusieurs comptes d'encaissement (JSON) : le compte par défaut d'un document est
# le premier de sa devise, « currency » vide valant pour toutes. Sans cette
# variable, le couple COMPANY_BANK / COMPANY_IBAN ci-dessus sert seul.
COMPANY_ACCOUNTS='[{"label":"Compte EUR","bank":"Banque Exemple SA","iban":"CH00 0000 0000 0000 0000 0","currency":"EUR"}]'
COMPANY_DEFAULT_VAT_RATE=8.1
COMPANY_DEFAULT_CURRENCY=EUR
COMPANY_PAYMENT_TERMS_DAYS=30
COMPANY_QUOTE_PREFIX=DV-27
COMPANY_QUOTE_VALIDITY_DAYS=30
OFFER_ACCOMPAGNE_CHF_CENTS=119000
OFFER_ACCOMPAGNE_EUR_CENTS=119000
OFFER_CONFIE_CHF_CENTS=219000
OFFER_CONFIE_EUR_CENTS=219000

# Autocomplétion d'adresse (Google Places, appelée côté serveur). Restreindre la clé par adresse IP.
# Connexion « Se connecter avec Google » (OAuth). Sans ces identifiants, le bouton
# n'apparaît pas et les routes répondent 404. Aucune inscription : seul un membre
# déjà créé peut entrer, reconnu par son adresse e-mail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Domaines autorisés, séparés par des virgules (vide = tous).
GOOGLE_ALLOWED_DOMAINS=

GOOGLE_MAPS_API_KEY=
# Visios : compte de service Google Workspace avec délégation (chemin du JSON, ou JSON en base64) et organisateur central.
GOOGLE_CALENDAR_KEY_FILE=
GOOGLE_CALENDAR_ORGANIZER=contact@relocation-in-paris.fr
# Carte des arrondissements (Maps JavaScript API, chargée dans le navigateur). Clé distincte, restreinte par référent HTTP.
GOOGLE_MAPS_BROWSER_KEY=
# Carte statique des e-mails : clé dédiée restreinte à l'API Maps Static (elle part dans les e-mails) + secret de signature d'URL.
GOOGLE_STATIC_MAPS_KEY=
GOOGLE_STATIC_MAPS_SECRET=
# Lien de signature du contrat (Yousign v3). Sandbox par défaut, https://api.yousign.app/v3 en production.
YOUSIGN_API_KEY=
YOUSIGN_BASE_URL=https://api-sandbox.yousign.app/v3
# Génération des PDF de factures (DocRaptor). test_mode=true = filigrane, non facturé.
DOC_RAPTOR_KEY=
DOC_RAPTOR_TEST_MODE=true

# Webhook du site Relocation In Paris (demandes de contact → leads) : même secret des deux côtés.
RIP_WEBHOOK_SECRET=

# Webhook de la téléphonie Allo (appels et SMS → notes et leads) : secret « whsec_… » affiché par Allo.
ALLO_WEBHOOK_SECRET=
# Envoi de SMS par Allo (alertes « lead sans premier contact » au conseiller) : clé API (Settings > API,
# portée SMS_SEND), numéro Allo expéditeur au format E.164, ou Sender ID alphanumérique vérifié par Allo (France).
ALLO_API_KEY=
ALLO_SMS_FROM=
ALLO_SMS_SENDER_ID=
ALLO_API_URL=https://api.withallo.com

###> IA (Claude) ###
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
###< IA ###
