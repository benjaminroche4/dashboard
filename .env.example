APP_NAME=Dashboard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

COMPANY_NAME="Relocation In Paris"
COMPANY_ADDRESS="Rue des Alpes 5\n1201 Genève\nSuisse"
COMPANY_EMAIL=contact@relocation-in-paris.com
COMPANY_PHONE="+33 1 84 80 43 44"
COMPANY_VAT_NUMBER="CHE-000.000.000 TVA"
COMPANY_IBAN="CH00 0000 0000 0000 0000 0"
COMPANY_BANK="Banque Exemple SA"
COMPANY_DEFAULT_VAT_RATE=8.1
COMPANY_DEFAULT_CURRENCY=EUR
COMPANY_PAYMENT_TERMS_DAYS=30
OFFER_ACCOMPAGNE_CHF_CENTS=119000
OFFER_ACCOMPAGNE_EUR_CENTS=119000
OFFER_CONFIE_CHF_CENTS=219000
OFFER_CONFIE_EUR_CENTS=219000

# Autocomplétion d'adresse (Google Places, appelée côté serveur). Restreindre la clé par adresse IP.
GOOGLE_MAPS_API_KEY=
# Génération des PDF de factures (DocRaptor). test_mode=true = filigrane, non facturé.
DOC_RAPTOR_KEY=
DOC_RAPTOR_TEST_MODE=true
